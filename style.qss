/* ===========================================================
 * 奥拉星立绘提取器 - Qt Style Sheet
 * 设计系统: 深空底色 + 青蓝/星紫双辉光, 科技感工具风
 * 颜色来源: styles.css 的 OKLCH token 转换为 sRGB hex
 * =========================================================== */

/* ===== 全局变量(注释, 便于维护; QSS 不支持 var, 必须硬编码) =====
 * background: #14152a   foreground: #f1f2f6
 * card:       #1f2138   primary:    #5fd4e8
 * accent:     #b36cd8   secondary:  #2c2945
 * muted:      #25243a   border:     #2f2e48
 * success:    #5fcf95   destructive:#d55440
 * primary-glow: #94e3eb
 * =========================================================== */

* {
    font-family: "Microsoft YaHei", "Noto Sans SC", "PingFang SC", sans-serif;
    font-size: 13px;
    color: #f1f2f6;
    outline: none;
}

/* ===== 主窗口: 深空底色 + 双辉光渐变 ===== */
QMainWindow, QWidget {
    background-color: #14152a;
    background-image: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(179, 108, 216, 0.08),
        stop:0.4 #14152a,
        stop:0.7 #14152a,
        stop:1 rgba(95, 212, 232, 0.06)
    );
}

/* ===== 分组容器 ===== */
QGroupBox {
    background-color: rgba(31, 33, 56, 0.85);
    border: 1px solid #2f2e48;
    border-radius: 10px;
    margin-top: 14px;
    padding: 14px 12px 10px 12px;
    font-weight: 600;
    color: #94e3eb;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    background-color: #14152a;
    color: #5fd4e8;
}

/* ===== 标签 ===== */
QLabel {
    background: transparent;
    color: #f1f2f6;
}
QLabel#label_pet_info {
    background-color: #25243a;
    border: 1px solid #3a5a7a;
    border-radius: 8px;
    padding: 10px 14px;
    color: #ffffff;
}
QLabel#label_preview {
    background-color: #25243a;
    border: 1px solid #3a5a7a;
    border-radius: 8px;
    color: #cccccc;
}
QLabel#lbl_bg_preview {
    border: 1px solid #3a5a7a;
    border-radius: 7px;
    min-height: 40px;
}

/* ===== 输入框 ===== */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #25243a;
    border: 1px solid #2f2e48;
    border-radius: 6px;
    padding: 6px 10px;
    color: #f1f2f6;
    selection-background-color: #5fd4e8;
    selection-color: #14152a;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #5fd4e8;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #2c2945;
    border: none;
    width: 16px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #5fd4e8;
}

/* ===== 下拉框 ===== */
QComboBox {
    background-color: #25243a;
    border: 1px solid #2f2e48;
    border-radius: 6px;
    padding: 5px 10px;
    min-height: 22px;
    color: #f1f2f6;
}
QComboBox:hover {
    border: 1px solid #5fd4e8;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #5fd4e8;
    width: 0; height: 0;
}
QComboBox QAbstractItemView {
    background-color: #1f2138;
    border: 1px solid #2f2e48;
    selection-background-color: #5fd4e8;
    selection-color: #14152a;
    outline: none;
    padding: 4px;
}

/* ===== 按钮: 通用态 ===== */
QPushButton {
    background-color: #2c2945;
    border: 1px solid #2f2e48;
    border-radius: 6px;
    padding: 7px 14px;
    color: #f1f2f6;
    min-height: 22px;
}
QPushButton:hover {
    background-color: #3a3760;
    border: 1px solid #5fd4e8;
    color: #94e3eb;
}
QPushButton:pressed {
    background-color: #25243a;
}
QPushButton:disabled {
    background-color: #1f2138;
    color: #5c5a78;
    border: 1px solid #25243a;
}

/* ===== 主按钮(青蓝辉光) ===== */
QPushButton#btnSearch,
QPushButton#btnDownloadSel,
QPushButton#btnPreview,
QPushButton#btnExportWp,
QPushButton#btnExportGif {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5fd4e8, stop:1 #94e3eb
    );
    color: #14152a;
    border: none;
    font-weight: 600;
    border-radius: 6px;
    padding: 8px 16px;
}
QPushButton#btnSearch:hover,
QPushButton#btnDownloadSel:hover,
QPushButton#btnPreview:hover,
QPushButton#btnExportWp:hover,
QPushButton#btnExportGif:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #94e3eb, stop:1 #b36cd8
    );
}
QPushButton#btnSearch:pressed,
QPushButton#btnDownloadSel:pressed,
QPushButton#btnPreview:pressed,
QPushButton#btnExportWp:pressed,
QPushButton#btnExportGif:pressed {
    background-color: #4ab8cc;
}

/* ===== 可选中按钮(checked 态用星紫) ===== */
QPushButton#btn_use_breath:checked {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #b36cd8, stop:1 #5fd4e8
    );
    color: #14152a;
    border: none;
}

/* ===== 列表 ===== */
QListWidget {
    background-color: #1f2138;
    border: 1px solid #2f2e48;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}
QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
    color: #f1f2f6;
}
QListWidget::item:hover {
    background-color: #2c2945;
}
QListWidget::item:selected {
    background-color: #5fd4e8;
    color: #14152a;
    font-weight: 600;
}

/* ===== 日志文本框 ===== */
QTextEdit {
    background-color: #1f2138;
    border: 1px solid #2f2e48;
    border-radius: 8px;
    padding: 6px;
    color: #94e3eb;
    font-family: "Consolas", "Microsoft YaHei", monospace;
    font-size: 12px;
}

/* ===== 进度条 ===== */
QProgressBar {
    background-color: #25243a;
    border: 1px solid #2f2e48;
    border-radius: 6px;
    text-align: center;
    color: #f1f2f6;
    min-height: 18px;
}
QProgressBar::chunk {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5fd4e8, stop:1 #b36cd8
    );
    border-radius: 5px;
}

/* ===== 状态栏 ===== */
QStatusBar {
    background-color: #1f2138;
    border-top: 1px solid #2f2e48;
    color: #94e3eb;
}

/* ===== 分割线 ===== */
QSplitter::handle {
    background-color: #2f2e48;
}
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical   { height: 2px; }

/* ===== 滚动条 ===== */
QScrollBar:vertical {
    background: #1f2138;
    width: 10px;
    border: none;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #2c2945;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #5fd4e8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: #1f2138;
    height: 10px;
    border: none;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background: #2c2945;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #5fd4e8; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ===== 提示: 用 QToolTip 暴露在外的样式 ===== */
QToolTip {
    background-color: #1f2138;
    color: #94e3eb;
    border: 1px solid #5fd4e8;
    border-radius: 4px;
    padding: 4px 8px;
}
